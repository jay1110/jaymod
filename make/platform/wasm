include make/platform/linux64

###############################################################################

# Builds cgame, ui and qagame as WebAssembly using the Emscripten toolchain.
# Requires the Emscripten SDK on PATH (source emsdk_env.sh), which provides
# em++ and emar.
EMXX ?= em++
EMAR ?= emar

###############################################################################

# The ".so" naming keeps the modules loadable through the engine's existing
# dlopen() based module loader.
IDMODULE.suffix = .mp.wasm32.so

###############################################################################

# Emscripten resolves libc/libm/dlopen symbols from the MAIN_MODULE at load
# time, so the SIDE_MODULEs must not link any explicit libraries.
DYNLOAD.l  =
MATH.l     =
IPHLPAPI.l =
ADVAPI.l   =
WS2_32.l   =

###############################################################################

CXX = $(EMXX)
AR  = $(EMAR)

CXX.D = JAYMOD_WASM
CXX.l =

CXX.opt.BIT    =
CXX.opt.O      = -O3 -ffast-math
CXX.opt.W      = -w
CXX.opt.static =

# SIDE_MODULEs must be position independent and, since cgame, ui and qagame
# share a lot of source, must not export anything but the module entry points.
CXX.opt.PIC    = -fPIC
CXX.opt.vis    = -fvisibility=hidden

CXX.PIC = 1
CXX.vis = 1

# Each module is linked as a SIDE_MODULE so that a MAIN_MODULE engine build can
# load it at runtime, exactly like the native .so/.dll modules on every other
# platform. Hidden visibility (inherited from linux64) is essential here:
# Emscripten resolves every default-visibility symbol of a SIDE_MODULE through
# one process-wide symbol table, and cgame, ui and qagame share a lot of source,
# so identically named globals would otherwise collide across modules.
#
# The module entry points are named explicitly so that they survive dead code
# elimination: nothing inside the module references vmMain, dllEntry or the
# vmWasmAbi1 ABI marker, they are only ever called by the engine.
WASM.exports = -sEXPORTED_FUNCTIONS=_vmMain,_dllEntry,_vmWasmAbi1

CXX.ldopts.exe = -sSIDE_MODULE=1 $(WASM.exports)
CXX.ldopts.so  = -sSIDE_MODULE=1 $(WASM.exports)

###############################################################################

SPECIALS.name  = wasm
SPECIALS.build = build.wasm
