GCC/ = /usr/

###############################################################################

IDMODULE.suffix  = _mac
IDMODULE.prefix  =
STATICLIB.suffix = .a

###############################################################################

DYNLOAD.l  =
MATH.l     =
IPHLPAPI.l =
ADVAPI.l   =

###############################################################################

M4     = m4
TAR    = tar
AR     = ar
RANLIB = /usr/bin/ranlib

###############################################################################

CXX = $(GCC/)bin/clang++

CXX.pch.ext  = gch
CXX.pch.arch = default

CXX.opt.D   = $(call fnPrefix,-D,$(CXX.D) $($(CXX.inherit).CXX.D))
CXX.opt.I   = $(call fnPrefix,-I,$($(CXX.inherit).CXX.I<) $(CXX.I) $($(CXX.inherit).CXX.I))
CXX.opt.L   = $(call fnPrefix,-L,$(CXX.L) $($(CXX.inherit).CXX.L))
CXX.opt.R   = $(call fnPrefix,-Xlinker -rpath ,$(CXX.R) $($(CXX.inherit).CXX.R))
CXX.opt.U   = $(call fnPrefix,-U,$(CXX.U) $($(CXX.inherit).CXX.U))
CXX.opt.l   = $(call fnPrefix,-l,$(CXX.l) $($(CXX.inherit).CXX.l))
CXX.opt.fwork = $(call fnPrefix,-framework ,$(CXX.fwork) $($(CXX.inherit).CXX.fwork))

CXX.arch       = x86_64
CXX.opt.arch   = $(call fnPrefix,-arch ,$(CXX.arch))
CXX.opt.ML     = -fmessage-length=0
CXX.opt.NSA    = -fno-strict-aliasing
CXX.opt.O      = -O3 -ffast-math
CXX.opt.PIC    =
CXX.opt.W      = -w
CXX.opt.g      = -g
CXX.opt.pipe   = -pipe
CXX.opt.p      = -p
CXX.opt.static =
CXX.opt.std    = -std=gnu++14 -fno-exceptions -fno-rtti
CXX.opt.vis    =

CXX.ldopts.exe =
CXX.ldopts.so  = -bundle -undefined dynamic_lookup

###############################################################################

CXX.D = JAYMOD_OSX64
CXX.I = $(BUILD/) $(PROJECT/)src $(PROJECT/)pak
CXX.L = $(BUILD/)
CXX.R =
CXX.U =
CXX.l =
CXX.fwork =

CXX.ML     = 1
CXX.NSA    = 1
CXX.O      =
CXX.PIC    =
CXX.W      = 1
CXX.g      =
CXX.pipe   = 1
CXX.p      =
CXX.static =
CXX.std    = 1
CXX.vis    =

###############################################################################

CXX.fnStrip =

###############################################################################

CXX.fnCompile = $(call print.COMMAND.normal,$(CXX),$(2),$(strip \
	$(CXX) \
	$(CXX.opt.arch) \
    $(foreach i,pipe W ML std NSA vis PIC O g p,$(foreach j,$(CXX.$(i)),$(CXX.opt.$(i)))) \
	$(CXX.opt.D) \
	$(CXX.opt.I) \
	$(CXX.opt.U) \
	-c $(1) -o $(2) \
	))

CXX.fnCompilePch = $(CXX.fnCompile)

###############################################################################

CXX.fnPrecompile = $(call print.COMMAND.magenta,$(CXX),$(2),$(strip \
	$(CXX) \
	$(CXX.opt.arch) \
    $(foreach i,pipe W ML std NSA vis PIC O g p,$(foreach j,$(CXX.$(i)),$(CXX.opt.$(i)))) \
	$(CXX.opt.D) \
	$(CXX.opt.I) \
	$(CXX.opt.U) \
	-c $(1) -o $(2) \
	))

###############################################################################

CXX.libstdcxx.DEPS =
CXX.libstdcxx.link =

BUILD.output += $(CXX.libstdcxx.DEPS)

###############################################################################

CXX.fnCompileStatic = $(call print.STATIC,$(AR),$(1),$(2),$(AR) cq $(1) $(2))

###############################################################################

# ar(1) on macOS does not write an archive symbol table; without ranlib the
# linker rejects the archive with "archive has no table of contents".
CXX.fnRanlib = $(call print.COMMAND.normal,$(RANLIB),$(1),$(RANLIB) $(1))

###############################################################################

CXX.fnLinkExe = $(call print.LINK,$(CXX),$(1),$(3),$(4),$(strip \
    $(CXX) \
    $(CXX.opt.arch) \
    $(foreach i,pipe W ML std NSA vis PIC O g p static,$(foreach j,$(CXX.$(i)),$(CXX.opt.$(i)))) \
    $(CXX.opt.D) \
    $(CXX.opt.I) \
    $(CXX.opt.U) \
    $(CXX.fnLinkExe.<<) $($(CXX.inherit).CXX.fnLinkExe.<<) \
    -o $(1) $(3) $(4) \
    $(CXX.ldopts.exe) \
    $(CXX.opt.R) \
    $(CXX.opt.L) \
    $(CXX.opt.l) \
    $(CXX.opt.fwork) \
    $(CXX.fnLinkExe.>>) $($(CC.inherit).CC.fnLinkExe.>>) \
    ))

###############################################################################

# Parameter list:
# 1 - Output name
# 2 - object list
CXX.fnLinkSo = $(call print.LINK,$(CXX),$(1),$(2),$(strip \
    $(CXX) \
    $(CXX.opt.arch) \
    $(foreach i,pipe W ML std NSA vis PIC O g p static,$(foreach j,$(CXX.$(i)),$(CXX.opt.$(i)))) \
    $(CXX.opt.D) \
    $(CXX.opt.I) \
    $(CXX.opt.U) \
    $(CXX.fnLinkSo.<<) $($(CXX.inherit).CXX.fnLinkSo.<<) \
    -o $(1) $(2) \
    $(CXX.ldopts.so) \
    $(CXX.opt.R) \
    $(CXX.opt.L) \
    $(CXX.opt.l) \
    $(CXX.opt.fwork) \
    $(CXX.fnLinkSo.>>) $($(CC.inherit).CC.fnLinkSo.>>) \
    ))

###############################################################################

SPECIALS.name  = osx64
SPECIALS.build = build.osx64
SPECIALS.base  = $(PROJECT.packageBase)-$(SPECIALS.name)
SPECIALS.base/ = $(BUILD/)$(SPECIALS.base)/

world:: default debug release
