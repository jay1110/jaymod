include make/platform/linux64

###############################################################################

IDMODULE.suffix = _mp_x64.dll

###############################################################################

DYNLOAD.l  =
MATH.l     =
IPHLPAPI.l = iphlpapi
ADVAPI.l   = advapi32
WS2_32.l   = ws2_32

###############################################################################

CXX = /usr/bin/x86_64-w64-mingw32-g++
AR  = /usr/bin/x86_64-w64-mingw32-ar

CXX.opt.PIC    =
CXX.opt.vis    =
CXX.opt.BIT    =
CXX.opt.static = -static-libgcc -static-libstdc++

CXX.ldopts.so = -shared

###############################################################################

SPECIALS.name  = win64
SPECIALS.build = build.mingw64
